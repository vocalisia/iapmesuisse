{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.iapmesuisse.ch"
        }
      ],
      "destination": "https://iapmesuisse.ch/$1",
      "permanent": true
    },
    {
      "source": "/fr/blog/cas-usage-ia-pme-suisse-priorisation",
      "destination": "/fr/blog/ia-pour-pme-suisses-cas-usages-2026",
      "permanent": true
    },
    {
      "source": "/fr/blog/cas-usage-ia-pme-suisse-priorisation/",
      "destination": "/fr/blog/ia-pour-pme-suisses-cas-usages-2026",
      "permanent": true
    },
    {
      "source": "/fr/blog/n8n-bexio-odoo-pme-suisse-automatisation",
      "destination": "/fr/blog/n8n-self-hosted-pme-suisse",
      "permanent": true
    },
    {
      "source": "/fr/blog/n8n-bexio-odoo-pme-suisse-automatisation/",
      "destination": "/fr/blog/n8n-self-hosted-pme-suisse",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
